import { ref, computed } from 'vue'
import { useRouter } from 'vue-router'

const API_BASE_URL = import.meta.env.VITE_API_BASE_URL;
const WP_API_BASE_URL = import.meta.env.VITE_WP_API_BASE_URL;

// Estado global de autenticación
const token = ref(localStorage.getItem('auth_token') || null)
const user = ref(JSON.parse(localStorage.getItem('user_data') || 'null'))
const loading = ref(false)
const isInitialized = ref(false)

export function useAuth() {
  const router = useRouter()

  const isAuthenticated = computed(() => !!token.value)
  const isAdmin = computed(() => {
    const roles = user.value?.roles || []
    const hasAdminRole = roles.includes('administrator')
    console.log('Checking isAdmin:', {
      userRoles: roles,
      isAdmin: hasAdminRole,
      user: user.value
    })
    return hasAdminRole
  })

  const getUserCapabilities = async () => {
    if (!token.value) return null

    try {
      const response = await fetch(`${WP_API_BASE_URL}/users/me`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token.value}`,
          'Content-Type': 'application/json'
        }
      })

      if (!response.ok) {
        throw new Error('Error al obtener capabilities del usuario')
      }

      const userData = await response.json()
      return {
        id: userData.id,
        username: userData.username,
        name: userData.name,
        first_name: userData.first_name,
        last_name: userData.last_name,
        email: userData.email,
        roles: userData.roles,
        capabilities: userData.capabilities,
        avatar: userData.avatar_urls?.['48'] || userData.avatar_urls?.['96'] || ''
      }
    } catch (error) {
      console.error('Error fetching user capabilities:', error)
      return null
    }
  }

  const login = async (username, password) => {
    try {
      loading.value = true

      const response = await fetch(`${API_BASE_URL}/token`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          username,
          password
        })
      })

      const data = await response.json()

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Error al iniciar sesión')
      }

      // Guardar token temporalmente
      token.value = data.data.token
      localStorage.setItem('auth_token', token.value)

      // Obtener capabilities del usuario
      const userCapabilities = await getUserCapabilities()

      if (!userCapabilities) {
        throw new Error('No se pudieron obtener los datos del usuario')
      }

      // Guardar datos completos del usuario
      user.value = {
        id: userCapabilities.id,
        email: userCapabilities.email,
        username: userCapabilities.username,
        name: userCapabilities.name,
        first_name: userCapabilities.first_name,
        last_name: userCapabilities.last_name,
        displayName: userCapabilities.name, // Para compatibilidad con código existente
        roles: userCapabilities.roles,
        capabilities: userCapabilities.capabilities,
        avatar: userCapabilities.avatar
      }

      // Persistir en localStorage
      localStorage.setItem('user_data', JSON.stringify(user.value))

      return { success: true, user: user.value }
    } catch (error) {
      throw error
    } finally {
      loading.value = false
    }
  }

  const validateToken = async () => {
    if (!token.value) return false

    try {
      const response = await fetch(`${API_BASE_URL}/token/validate`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token.value}`,
          'Content-Type': 'application/json'
        }
      })

      const data = await response.json()
      return response.ok && data.success
    } catch (error) {
      console.error('Error validating token:', error)
      return false
    }
  }

  const logout = () => {
    token.value = null
    user.value = null
    localStorage.removeItem('auth_token')
    localStorage.removeItem('user_data')
    router.push('/login')
  }

  const initializeAuth = async () => {
    // Solo inicializar una vez
    if (isInitialized.value) return

    if (token.value) {
      // Si el usuario no tiene roles (datos antiguos), obtener capabilities
      if (!user.value?.roles || user.value.roles.length === 0) {
        const userCapabilities = await getUserCapabilities()
        if (userCapabilities) {
          user.value = {
            id: userCapabilities.id,
            email: userCapabilities.email,
            username: userCapabilities.username,
            name: userCapabilities.name,
            first_name: userCapabilities.first_name,
            last_name: userCapabilities.last_name,
            displayName: userCapabilities.name,
            roles: userCapabilities.roles,
            capabilities: userCapabilities.capabilities,
            avatar: userCapabilities.avatar
          }
          localStorage.setItem('user_data', JSON.stringify(user.value))
        }
      }

      const isValid = await validateToken()
      if (!isValid) {
        logout()
      } else {
        isInitialized.value = true
      }
    } else {
      isInitialized.value = true
    }
  }

  return {
    token: computed(() => token.value),
    user: computed(() => user.value),
    loading: computed(() => loading.value),
    isAuthenticated,
    isAdmin,
    login,
    logout,
    validateToken,
    initializeAuth,
    getUserCapabilities
  }
}